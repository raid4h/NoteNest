<DashboardTile>:
    theme_bg_color: "Custom"
    size_hint_x: 1
    size_hint_y: None
    height: dp(110)
    radius: [18]
    ripple_behavior: True
    elevation: 1
    shadow_softness: 4
    shadow_offset: 0, -2

    MDBoxLayout:
        orientation: "horizontal"
        padding: dp(18), dp(14)
        spacing: dp(14)

        AnchorLayout:
            size_hint_x: None
            width: dp(52)
            anchor_x: "center"
            anchor_y: "center"

            MDCard:
                id: icon_container
                theme_bg_color: "Custom"
                size_hint: None, None
                size: dp(44), dp(44)
                radius: [16]
                pos_hint: {"center_y": 0.5}

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"

                    MDIconButton:
                        id: tile_icon
                        icon: root.icon_name
                        theme_icon_color: "Custom"
                        size_hint: None, None
                        size: dp(32), dp(32)
                        on_release: root.on_release()

        AnchorLayout:
            anchor_x: "center"
            anchor_y: "center"
            size_hint_x: 1

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(3)
                pos_hint: {"center_y": 0.5}

                MDLabel:
                    id: tile_label
                    text: root.label
                    halign: "left"
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "medium"
                    adaptive_height: True
                    text_size: self.width, None
                    shorten: True
                    shorten_from: 'right'

                MDLabel:
                    id: tile_subtitle
                    text: root.subtitle
                    halign: "left"
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"
                    adaptive_height: True
                    text_size: self.width, None
                    shorten: True
                    shorten_from: 'right'


        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: dp(60)
            spacing: dp(0)
            pos_hint: {"center_y": 0.5}

            MDLabel:
                id: stat_number
                text: root.stat_number
                halign: "right"
                theme_text_color: "Custom"
                theme_font_size: "Custom"
                font_size: sp(26)
                bold: True
                adaptive_height: True

            MDLabel:
                id: stat_label
                text: root.stat_label
                halign: "right"
                theme_text_color: "Custom"
                font_style: "Label"
                role: "small"
                adaptive_height: True


<SmallTile>:
    theme_bg_color: "Custom"
    size_hint: 1, None
    height: dp(120)
    radius: [18]
    ripple_behavior: True
    elevation: 1
    on_release: root.on_release()

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(8)

        MDCard:
            id: icon_container
            theme_bg_color: "Custom"
            size_hint: None, None
            size: dp(36), dp(36)
            radius: [11]

            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"

                MDIconButton:
                    id: tile_icon
                    icon: root.icon_name
                    theme_icon_color: "Custom"
                    size_hint: None, None
                    size: dp(28), dp(28)

        MDLabel:
            id: tile_label
            text: root.label
            theme_text_color: "Custom"
            font_style: "Title"
            role: "small"
            adaptive_height: True

        MDLabel:
            id: tile_stat
            text: root.stat_text
            theme_text_color: "Custom"
            font_style: "Label"
            role: "small"
            adaptive_height: True


<HomeScreen>:
    MDBoxLayout:
        id: drawer_layout
        orientation: "vertical"
        padding: dp(20), dp(16), dp(20), dp(24)
        spacing: dp(16)

        # ── top row: greeting + settings ──
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            adaptive_height: True

            MDBoxLayout:
                orientation: "vertical"

                MDLabel:
                    id: date_label
                    text: ""
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"
                    adaptive_height: True
                    text_size: self.width, None
                    shorten: True
                    shorten_from: 'right'

                MDLabel:
                    id: greeting_label
                    text: "Good evening"
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "large"
                    adaptive_height: True
                    text_size: self.width, None
                    shorten: True
                    shorten_from: 'right'

            MDIconButton:
                id: menu_button
                icon: "cog-outline"
                theme_icon_color: "Custom"
                pos_hint: {"center_y": 0.5}
                on_release: root.open_settings()
        
         # ── Continue Studying (only shown when there's an active session) ──
        MDBoxLayout:
            id: continue_studying_container
            orientation: "vertical"
            spacing: dp(16)
            size_hint_y: None
            adaptive_height: True

        # ── hero tile: Up next ──
        MDLabel:
            text: "Next Up"
            theme_text_color: "Custom"
            font_style: "Title"
            role: "small"
            adaptive_height: True

        DashboardTile:
            id: up_next_tile
            label: ""
            subtitle: ""
            icon_name: "calendar-clock-outline"

        Widget:

        # ── Today's Plan ──
        MDLabel:
            text: "Today's Plan"
            theme_text_color: "Custom"
            font_style: "Title"
            role: "small"
            adaptive_height: True

        MDCard:
            id: today_plan_card
            theme_bg_color: "Custom"
            radius: [16]
            elevation: 0
            size_hint_y: None
            height: today_plan_list.height + dp(28)
            padding: dp(14)

            MDBoxLayout:
                id: today_plan_list
                orientation: "vertical"
                spacing: dp(6)